data-astro-cid-pvvruvv3="true" data-icon="mdi:account">   <symbol id="ai:mdi:account" viewBox="0 0 24 24"><path fill="currentColor" d="M12 4a4 4 0 0 1 4 4a4 4 0 0 1-4 4a4 4 0 0 1-4-4a4 4 0 0 1 4-4m0 10c4.42 0 8 1.79 8 4v2H4v-2c0-2.21 3.58-4 8-4"/></symbol><use href="#ai:mdi:account"></use>  </svg> <span data-astro-cid-pvvruvv3>Sobre mi</span> </button> </div> </div> </div> <div id="about-me-modal" class="modal-container" data-astro-cid-pvvruvv3> <div class="modal-content" data-astro-cid-pvvruvv3> <button id="close-modal-button" class="close-button" data-astro-cid-pvvruvv3>&times;</button> <h2 style="text-align: center;" data-astro-cid-pvvruvv3>Acerca de Kewisito</h2> <p data-astro-cid-pvvruvv3>¡Hola! Soy Kewisito, un apasionado streamer y creador de contenido de Venezuela. Me dedico a compartir mis pasiones, desde videojuegos hasta charlas casuales, con una comunidad increíble que hemos construido juntos. Mi objetivo es crear un espacio positivo y divertido donde todos se sientan bienvenidos.</p> <p data-astro-cid-pvvruvv3>Aquí encontrarás risas, buenos momentos y, con suerte, algo que te inspire o te alegre el día. ¡Gracias por ser parte de esta aventura!</p> </div> </div>  <script>
  function setupPage() {
    // Interactive Background
    const container = document.querySelector('.container');
    if (container) {
      let isDesktop = window.innerWidth >= 768;

      const handleMouseMove = (e) => {
        if (!isDesktop) return;
        const { clientX: x, clientY: y } = e;
        const { offsetWidth: width, offsetHeight: height } = container;
        const xPercent = (x / width) * 100;
        const yPercent = (y / height) * 100;
        requestAnimationFrame(() => {
          container.style.backgroundPosition = `${xPercent}% ${yPercent}%`;
        });
      };

      const handleResize = () => {
        isDesktop = window.innerWidth >= 768;
        if (!isDesktop) {
          container.style.backgroundPosition = ''; // Reset style for mobile
        }
      }

      window.addEventListener('resize', handleResize);
      container.addEventListener('mousemove', handleMouseMove);
      handleResize(); // Initial check
    }

    // Modal Logic
    const aboutMeButton = document.getElementById('about-me-button');
    const modal = document.getElementById('about-me-modal');
    const closeModalButton = document.getElementById('close-modal-button');

    if (aboutMeButton && modal && closeModalButton) {
      aboutMeButton.addEventListener('click', () => {
        modal.classList.add('is-visible');
      });

      const closeModal = () => {
        modal.classList.remove('is-visible');
      }

      closeModalButton.addEventListener('click', closeModal);
      modal.addEventListener('click', (event) => {
        if (event.target === modal) {
          closeModal();
        }
      });
    }
  }

  // Run the script on initial page load and subsequent navigations
  document.addEventListener('astro:page-load', setupPage);
  setupPage(); // Run on initial load as well
</script>  <!-- Cloudflare Pages Analytics --><script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "99da33a972e04aa292e4fc1b999dcbc2"}'></script><!-- Cloudflare Pages Analytics --></body></html>